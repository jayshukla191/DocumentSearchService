{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": ["ec2:*", "ecs:*", "ecr:*", "rds:*"],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": ["iam:*", "secretsmanager:*", "cloudfront:*"],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": ["elasticloadbalancing:*", "logs:*", "application-autoscaling:*"],
            "Resource": "*"
        }
    ]
}

